http://localhost {
    log {
        output stdout
        format console
        level DEBUG
    }

    # Handle API and GeoServer paths
    handle /api/* {
        reverse_proxy api-backend:81 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }
    reverse_proxy /geoserver* geoserver:8080
    
    # Handle everything else with more detailed proxy configuration
    reverse_proxy /* viewer:80 {
        transport http {
            response_header_timeout 30s
            read_buffer 4096
        }
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_down -Server  # Remove duplicate server header
    }
}